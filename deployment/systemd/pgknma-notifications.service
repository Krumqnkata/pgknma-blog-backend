[Unit]
Description=PGKNMA scheduled notifications dispatcher
After=network.target mysql.service

[Service]
Type=oneshot
User=webmaster
Group=www-data
WorkingDirectory=/var/www/blog/cms/cms
ExecStart=/var/www/blog/cms/venv/bin/python manage.py dispatch_scheduled_notifications

[Install]
WantedBy=multi-user.target
