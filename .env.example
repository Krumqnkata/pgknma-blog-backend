# Copy this file to .env for local development. Never commit .env.
# Production must use newly rotated values, not the old values from Git history.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TRUST_X_FORWARDED_PROTO=False
DJANGO_USE_X_FORWARDED_HOST=False
TRUSTED_PROXY_IPS=

# Local SQLite
DB_ENGINE=sqlite
DB_NAME=
ALLOW_PRODUCTION_SQLITE=False
SQLITE_TIMEOUT_SECONDS=30

# Production MySQL example:
# DB_ENGINE=mysql
# DB_NAME=pgknma_blog
# DB_USER=django_prod
# DB_PASSWORD=
# DB_HOST=/var/run/mysqld/mysqld.sock
# DB_PORT=
# DB_CONN_MAX_AGE=60

ENABLE_GOOGLE_AUTH=False
GOOGLE_CLIENT_ID=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Cloudflare Workers AI (по избор). Без тях всички ИИ функции са изключени.
# Копчетата и изборът на модели са в админ панела: Настройки на сайта -> ИИ.
CF_ACCOUNT_ID=
CF_API_TOKEN=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_BATCH_SIZE=20
AI_ASSISTANT_DAILY_LIMIT=120
# Път до site-knowledge.json от билда на фронтенда (по избор; иначе се тегли от сайта).
AI_SITE_KNOWLEDGE_PATH=

DEFAULT_FROM_EMAIL=PGKNMA Blog <noreply@pgknma.space>
EMAIL_VERIFICATION_REPLY_TO=support@pgknma.space
PUBLIC_SITE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
WEB_PUSH_ENABLED=False
VAPID_PUBLIC_KEY=
# PEM private key contents or an absolute path accepted by pywebpush.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@pgknma.space
WEB_PUSH_MAX_PUBLIC_PER_HOUR=10
WEB_PUSH_EVENT_REMINDER_HOURS=24
WEB_PUSH_REQUEST_TIMEOUT_SECONDS=10
# Comma-separated trusted browser push providers. The defaults cover Chrome,
# Firefox, Safari and Edge; add a host only after verifying its ownership.
WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,android.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_NUMBER_FILES=25
MAX_MEME_UPLOAD_SIZE=5242880
MAX_IMAGE_UPLOAD_SIZE=41943040
MAX_AVATAR_UPLOAD_SIZE=5242880
TEAM_CHAT_MAX_IMAGE_UPLOAD_SIZE=5242880
MAX_DOCUMENT_UPLOAD_SIZE=1048576000

CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5173

# Production HTTPS hardening
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Use a shared cache in production. The database backend requires:
# python manage.py createcachetable
# CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# CACHE_LOCATION=django_cache
CACHE_DEFAULT_TIMEOUT=900
CACHE_MAX_ENTRIES=1000
CACHE_CULL_FREQUENCY=3
VALENTINE_TRUSTED_PROXY_IPS=
VALENTINE_LOGIN_MAX_ATTEMPTS=5
VALENTINE_LOGIN_WINDOW_SECONDS=900

API_PAGE_SIZE=25
THROTTLE_ANON=60/minute
THROTTLE_USER=300/minute
THROTTLE_LOGIN=5/minute
THROTTLE_REGISTER=5/hour
THROTTLE_GOOGLE_AUTH=10/minute
THROTTLE_CONTACT=5/hour
THROTTLE_CONSENT=30/hour
THROTTLE_USERNAME_CHECK=30/minute
THROTTLE_PASSWORD_VALIDATE=20/minute
THROTTLE_SONG_SUBMIT=5/day
THROTTLE_MEME_SUBMIT=5/day
THROTTLE_VOTE=60/hour
THROTTLE_SESSION_MANAGEMENT=30/hour
THROTTLE_PERSONAL_DATA_EXPORT=3/day
THROTTLE_PROFILE_AVATAR=10/hour
THROTTLE_EMAIL_VERIFICATION_RESEND=3/hour
THROTTLE_SEARCH=60/minute
THROTTLE_AI_ASSISTANT_USER=60/day
THROTTLE_AI_ASSISTANT_ANON=30/day
THROTTLE_PUSH_SUBSCRIPTION=30/hour
BLOG_SESSION_LAST_SEEN_UPDATE_SECONDS=900
BLOG_SESSION_RETENTION_DAYS=90
PERSONAL_DATA_RETENTION_DAYS=90
