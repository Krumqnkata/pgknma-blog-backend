# Production template. Copy to .env on the server and fill every blank secret
# with a newly rotated value. Never reuse values found in Git history.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
DJANGO_ALLOWED_HOSTS=pgknma.space,www.pgknma.space
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_USE_X_FORWARDED_HOST=False
TRUSTED_PROXY_IPS=127.0.0.1,::1
MAXMIND_ASN_DATABASE=/var/www/blog/cms/data/GeoLite2-ASN.mmdb
SITEMAP_DOMAIN=pgknma.space
SITEMAP_PROTOCOL=https

DB_ENGINE=mysql
DB_NAME=pgknma_blog
DB_USER=django_prod
DB_PASSWORD=
DB_HOST=/var/run/mysqld/mysqld.sock
DB_PORT=
DB_CONN_MAX_AGE=60
ALLOW_PRODUCTION_SQLITE=False
SQLITE_TIMEOUT_SECONDS=30

ENABLE_GOOGLE_AUTH=True
GOOGLE_CLIENT_ID=
TURNSTILE_SECRET_KEY=
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_NUMBER_FILES=25
MAX_MEME_UPLOAD_SIZE=5242880
MAX_IMAGE_UPLOAD_SIZE=10485760
MAX_DOCUMENT_UPLOAD_SIZE=26214400

CORS_ALLOWED_ORIGINS=https://pgknma.space,https://www.pgknma.space
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=https://pgknma.space,https://www.pgknma.space

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=django_cache
CACHE_DEFAULT_TIMEOUT=900
CACHE_MAX_ENTRIES=100000
CACHE_CULL_FREQUENCY=3
VALENTINE_TRUSTED_PROXY_IPS=127.0.0.1,::1
VALENTINE_LOGIN_MAX_ATTEMPTS=5
VALENTINE_LOGIN_WINDOW_SECONDS=900
VALENTINE_PIN_MAX_ATTEMPTS=5
VALENTINE_PIN_LOCK_SECONDS=900

THROTTLE_ANON=60/minute
THROTTLE_USER=300/minute
THROTTLE_LOGIN=5/minute
THROTTLE_REGISTER=5/hour
THROTTLE_GOOGLE_AUTH=10/minute
THROTTLE_CONTACT=5/hour
THROTTLE_CONSENT=30/hour
THROTTLE_USERNAME_CHECK=30/minute
THROTTLE_PASSWORD_VALIDATE=20/minute
THROTTLE_SONG_SUBMIT=5/day
THROTTLE_MEME_SUBMIT=5/day
THROTTLE_VOTE=60/hour
THROTTLE_SESSION_MANAGEMENT=30/hour
THROTTLE_PERSONAL_DATA_EXPORT=3/day
BLOG_SESSION_LAST_SEEN_UPDATE_SECONDS=900
BLOG_SESSION_RETENTION_DAYS=90
PERSONAL_DATA_RETENTION_DAYS=90
